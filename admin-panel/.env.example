# ============================================================================
# .env — پیکربندی پنل مدیریت (این فایل را در گیت کامیت نکنید!)
# کپی به: admin-panel/.env  و مقادیر را تغییر دهید
# ============================================================================

# رمز ورود مدیر (⚠️ حتماً تغییر دهید — حداقل ۸ کاراکتر)
ADMIN_PASSWORD=admin1234

# کلید رمزنگاری رازها (اگر خالی باشد خودکار تولید و در data/secret.key ذخیره می‌شود)
SECRET_KEY=

# --- هوش مصنوعی AvalAI (اختیاری — از UI تنظیمات هم می‌توانید وارد کنید) ---
AVALAI_API_KEY=
AVALAI_MODEL=qwen3.8-flash

# --- ربات تلگرام (اختیاری — از UI تنظیمات هم می‌توانید وارد کنید) ---
# همان رباتی که افزونه، فایل‌های خروجی را به چت ادمین‌اش می‌فرستد
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=

# اگر پنل پشت HTTPS است true بگذارید (کوکی Secure)
COOKIE_SECURE=false
