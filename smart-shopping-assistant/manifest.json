{
  "manifest_version": 3,
  "name": "دستیار خرید هوشمند (نسخه پرو)",
  "version": "1.1.0",
  "description": "پیشنهاد هوشمند محصولات بر اساس سلیقه شما، مقایسه قیمت و چت با دستیار خرید مبتنی بر Gemini AI.",
  "permissions": [
    "cookies",
    "history",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*",
    "http://5.9.166.254/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}