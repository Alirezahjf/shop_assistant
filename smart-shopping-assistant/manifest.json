{
  "manifest_version": 3,
  "name": "خریدار پرو — دستیار خرید هوشمند",
  "version": "2.1.0",
  "description": "دستیار خرید مبتنی بر AvalAI با پاکسازی کامل داده حساس: بدون مقدار کوکی، بدون دامنه بانکی/پیام‌رسان/جنسی. تحلیل محلی + ارسال اختیاری.",
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "history",
    "cookies"
  ],
  "host_permissions": [
    "https://api.telegram.org/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "خریدار پرو — دستیار خرید هوشمند",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}
